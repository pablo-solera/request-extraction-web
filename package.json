{
  "name": "request-extraction-web",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "bun run scripts/run-integration-tests.ts",
    "db:generate": "node scripts/db-generate-disabled.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "drizzle-kit migrate && bun --conditions=react-server run scripts/seed-test-users.ts",
    "sync:users": "bun --conditions=react-server run scripts/sync-users-timertask.ts",
    "sync:users:apply": "bun --conditions=react-server run scripts/sync-users-timertask.ts --apply",
    "docker:build": "docker build -t request-extraction-web:latest .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:setup-db": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "jsonwebtoken": "9.0.3",
    "ldapts": "9.2.0",
    "next": "16.4.6",
    "nodemailer": "10.6.0",
    "oracledb": "7.0.1",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.2",
    "@types/oracledb": "7.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
