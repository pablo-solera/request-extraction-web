# PostgreSQL
POSTGRES_DB=request_extraction
POSTGRES_USER=request_extraction
POSTGRES_PASSWORD=request_extraction_dev
DATABASE_URL=postgres://request_extraction:request_extraction_dev@127.0.0.1:5432/request_extraction

# Session. Generate at least 32 random bytes and keep this value private.
SESSION_SECRET=
# Leave unset in production; production cookies are always Secure.
SESSION_COOKIE_SECURE=

# Active Directory over LDAP, matching work-from-home. Port 3268 is Global Catalog.
INTEGRATION_LDAP_URL=ldap://ad.example.internal:3268
INTEGRATION_LDAP_ACCESSACCOUNT_UPN=service-account@example.internal
INTEGRATION_LDAP_ACCESSACCOUNT_PWD=
INTEGRATION_LDAP_USER_BASESEARCHGROUP=DC=example,DC=internal
# Optional nested AD group restriction. Leave empty to allow every active AD user.
INTEGRATION_LDAP_ALLOWED_GROUP_DN=

# TimerTask / Oracle organization authority
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
ORACLE_CLIENT_LIB_DIR=
ORACLE_TIMERTASK_SCHEMA=TIMERTASK_ES
ORACLE_STAFF_LINE_IDS=100,1600,1606,1608,1611
ORACLE_COORDINATOR_GROUP_ID=1017
ORACLE_ADMIN_GROUP_ID=1024
ORACLE_EXCLUDED_GROUP_IDS=1040,1057,1060,1066
ORG_SNAPSHOT_TTL_SECONDS=60
TEST_ACCOUNTS_ENABLED=false
TEST_ACCOUNTS_PASSWORD=
TEST_ACCOUNT_ADMIN=3509:test.manager@solera.com
TEST_ACCOUNT_COORDINATOR=3510:test.coordinator@solera.com
TEST_ACCOUNT_EMPLOYEE=3511:test.employee@solera.com
# Renault reader. These values must match POST /labours/options.
RENAULT_READER_BASE_URL=http://127.0.0.1:3001
RENAULT_READER_FORMAT=json
RENAULT_READER_LANGUAGE=es
RENAULT_READER_RANGE=active
RENAULT_READER_DOWNLOAD_ORIGIN=https://s3.example.internal
RECONCILE_SECRET=

# BMW Reader integration and infrastructure status. HTTP is permitted only for loopback.
# If the web app runs in Docker, use host.docker.internal or the reader's shared-network service name.
BMW_READER_BASE_URL=
BMW_READER_LANGUAGE=en-GB

# BMW Transformer (loads extracted data into BMW_Labour and compares .LST files). HTTP is permitted only for loopback.
BMW_TRANSFORMER_BASE_URL=

# Optional public CA for a remote PostgreSQL server.
DATABASE_CA_CERT_PATH=
